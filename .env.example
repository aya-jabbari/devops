# Copier vers .env : cp .env.example .env  (ne jamais commiter .env)
# Valeurs d'exemple pour le DEV LOCAL uniquement : aucun vrai secret ici.

POSTGRES_USER=supportops
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=supportops

# Clé de signature des JWT. Générer une valeur : openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl

# Secret partagé avec Alertmanager pour le webhook incidents.
ALERTMANAGER_WEBHOOK_SECRET=change-me
